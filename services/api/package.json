{
  "name": "@act/api",
  "version": "1.0.0-rc.1",
  "description": "ACT reference HTTP service implementing a first slice of the /v1 API contract.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx watch src/server.ts",
    "dev:oidc": "tsx src/oidc/dev-provider.ts",
    "start": "node dist/server.js",
    "migrate": "node dist/bin/migrate.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@act/core": "workspace:*",
    "@act/crypto": "workspace:*",
    "@act/ledger": "workspace:*",
    "@act/policy": "workspace:*",
    "@act/verification": "workspace:*",
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.8",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@act/sdk": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
